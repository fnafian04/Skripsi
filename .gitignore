# ==========================================
# Nafinder - Git Ignore Configuration
# ==========================================

# Byte-compiled / optimized / Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environment
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!*.example

# Temporary and log files
*.log
scratch/

# Database SQLite / local temp files
*.sqlite3
*.db

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# Large dataset caches and generated pipeline artifacts
uploads_tmp/*.csv
uploads_tmp/*.pkl
uploads_tmp/.*.pkl
uploads_tmp/.*.csv
uploads_tmp/datasets/*.csv

# Kecualikan dataset final dan registry/state agar Vercel dapat membaca dataset awal
!uploads_tmp/datasets/dataset_Nov_preprocessed.csv
!uploads_tmp/.datasets_registry.json
!uploads_tmp/.pipeline_state.json
!uploads_tmp/.gitkeep
!uploads_tmp/datasets/.gitkeep

# Pastikan model assets tidak ter-ignore
!processing/assets/*
