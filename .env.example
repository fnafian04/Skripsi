# ==================================================================
# Nafinder Environment Variables Template
# Salin file ini menjadi .env untuk pengujian lokal dengan Supabase
# Di Vercel: masukkan variabel-variabel ini pada menu Settings > Environment Variables
# ==================================================================

# Flask Secret Key (Ganti dengan string acak rahasia)
SECRET_KEY=nafinder-super-secret-key-skripsi-2026

# ==================================================================
# 1. KONEKSI SUPABASE (POSTGRESQL) - UNTUK CLOUD & VERCEL
# Dapatkan di dashboard Supabase: Project Settings > Database > Connection String
# Catatan untuk Serverless (Vercel): Disarankan gunakan Connection Pooling (Port 6543 / 5432)
# ==================================================================
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==================================================================
# 2. KONEKSI FALLBACK LOKAL MYSQL (LARAGON)
# Jika DATABASE_URL dikosongkan, sistem otomatis memakai MySQL Laragon:
# ==================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nafinder
DB_USER=root
DB_PASS=
